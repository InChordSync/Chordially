STELLAR_SPONSOR_SECRET_KEY=
STELLAR_SPONSOR_PUBLIC_KEY=
STELLAR_SPONSOR_LOW_BALANCE_XLM=50
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
ANCHOR_BASE_URL=https://testanchor.stellar.org/sep24
CREATOR_PAYOUT_MINIMUM_AMOUNT=10
TIP_RATE_LIMIT_WINDOW_MS=10000
TIP_RATE_LIMIT_PER_FAN=5
TIP_RATE_LIMIT_PER_STREAM=30
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MS=60000
RECONCILIATION_STUCK_THRESHOLD_MS=60000
RECONCILIATION_DEAD_LETTER_THRESHOLD_MS=300000

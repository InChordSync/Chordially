NODE_ENV=development
# Minimum severity the structured logger emits: debug, info, warn, or error.
LOG_LEVEL=info
PORT=4000
DATABASE_URL=file:./dev.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_KMS_KEY_ID=replace-with-a-kms-key-id
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
# Leave both empty to fall back to Friendbot (testnet only, for local dev).
STELLAR_SPONSOR_SECRET_KEY=
STELLAR_SPONSOR_PUBLIC_KEY=
STELLAR_SPONSOR_LOW_BALANCE_XLM=50
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
ANCHOR_BASE_URL=https://testanchor.stellar.org/sep24
CREATOR_PAYOUT_MINIMUM_AMOUNT=10
TIP_RATE_LIMIT_WINDOW_MS=10000
TIP_RATE_LIMIT_PER_FAN=5
TIP_RATE_LIMIT_PER_STREAM=30
RECONCILIATION_INTERVAL_MS=60000
RECONCILIATION_STUCK_THRESHOLD_MS=60000
RECONCILIATION_DEAD_LETTER_THRESHOLD_MS=300000
# Set both to false/true explicitly — z.coerce.boolean() would treat "false" as true.
RECONCILIATION_ENABLED=false
# Webhook authentication secrets. Required in production.
DEPOSIT_WEBHOOK_SECRET=
CREATOR_PAYOUT_WEBHOOK_SECRET=
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
# Swagger UI/docs. Automatically disabled when NODE_ENV=production.
DOCS_ENABLED=true
# Optional HTTP basic credentials protecting /api/docs.
DOCS_BASIC_AUTH_USER=
DOCS_BASIC_AUTH_PASSWORD=
# Optional bearer token protecting /api/metrics. Unset disables the route.
METRICS_SCRAPE_TOKEN=
HEALTH_HEAP_LIMIT_MB=150
HEALTH_PROBE_TIMEOUT_MS=2000

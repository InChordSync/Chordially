{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "target/wasm32v1-none/release/*.wasm",
        "*/target/wasm32v1-none/release/*.wasm"
      ],
      "inputs": ["$TURBO_DEFAULT$", "**/*.rs", "Cargo.toml", "Cargo.lock"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
